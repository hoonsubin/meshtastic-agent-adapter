# Meshtastic Bridge env file (TEMPLATE)
#
# Copy to /etc/meshtastic-bridge/.env on the bridge host and fill in the
# values that match your network. The systemd unit reads this file
# (root-owned, mode 0600) and exposes every variable to the bridge process.
#
# deploy/install.sh manages MESHTASTIC_AGENT_KEY for you: pass it via the
# shell var `MESHTASTIC_AGENT_KEY=...` on install, or edit in place and
# restart. The other variables below are read by config.yaml at startup,
# so any change here needs a service restart:
#
#   sudo systemctl restart meshtastic-bridge
#
# Values referenced as ${VAR} or ${VAR:-default} in config.yaml are resolved
# from this file's environment. Names have to be UPPER_SNAKE_CASE (regex is
# restrictive on purpose, so it does not eat the {max_bytes} / {from_id}
# .format() placeholders in agent.system_prompt). Unset names are left as the
# literal ${VAR} in the parsed config so missing values fail loudly later.

# ---------------------------------------------------------------------------
# Required: agent API key
# ---------------------------------------------------------------------------
# Bearer token for the Hermes API server (chat completions). This is the only
# secret in this file. Treat it like a password.
#
# You do not have to set it by hand: deploy/install.sh takes it from the
# `MESHTASTIC_AGENT_KEY` shell variable when it runs. Set it here only if you
# are managing the env file yourself.
MESHTASTIC_AGENT_KEY=replace-me-with-the-real-key

# ---------------------------------------------------------------------------
# Agent URL (referenced by config.yaml -> agent.url)
# ---------------------------------------------------------------------------
# Host and port of the Hermes API server. Same format used by config.yaml:
# http://${AGENT_HOST}:${AGENT_PORT}/v1/chat/completions
AGENT_HOST=192.168.0.100
AGENT_PORT=8642

# ---------------------------------------------------------------------------
# Agent model (referenced by config.yaml -> agent.model)
# ---------------------------------------------------------------------------
# Defaults to `hermes-agent` when unset (the `${AGENT_MODEL:-hermes-agent}`
# form in config.yaml provides that fallback). Set this when you want to point
# the bridge at a different model on the same API server.
# AGENT_MODEL=hermes-agent
# AGENT_MODEL=qwen3.7-plus

# ---------------------------------------------------------------------------
# Optional: serial port for the Meshtastic node
# ---------------------------------------------------------------------------
# Referenced by config.yaml -> serial.port when you swap
# `serial.port: ${SERIAL_PORT:-/dev/ttyUSB0}` into config.yaml. Useful when the
# bridge runs as a container or on a host where the node attaches to a
# different tty each boot.
# SERIAL_PORT=/dev/ttyUSB0